# 複製這個檔案並改名為 .env，再填入你自己的金鑰
# 這個檔案不要上傳到 GitHub！

# 必填：Gemini API 金鑰（免費，https://aistudio.google.com/apikey 用 Google 帳號登入取得）
GOOGLE_API_KEY=

# 選填：指定 Gemini 模型（預設 gemini-3.5-flash）
GEMINI_MODEL=gemini-3.5-flash

# 建議填：氣象署開放資料金鑰（免費，https://opendata.cwa.gov.tw 註冊會員後取得）
CWA_API_KEY=

# 選填：NCDR 防災示警平台金鑰（查詢出現 429 限流時建議申請）
NCDR_API_KEY=

# 選填：啟動時預設進入的歷史災難演練情境（留空代表即時官方 API 模式）
# 例如：DISASTER_SCENARIO=2024_gaemi_typhoon
DISASTER_SCENARIO=

# 選填：高風險自動告警外部 Webhook（支援 Discord / Slack / n8n / 自建系統）
# 留空時仍會自動寫入 logs/alerts_log.jsonl 並在對話中回報自動推播結果
ALERT_WEBHOOK_URL=

# 選填：公開部署時的簡易通關密碼（留空表示不鎖密碼，點開即用）
ACCESS_PASSWORD=

# 選填：公開部署防濫用頻率限制（單一 IP 每分鐘／每 10 分鐘最多分析次數）
ANALYZE_RATE_LIMIT_1M=4
ANALYZE_RATE_LIMIT_10M=15

# 選填：主動式監測推播 Agent 背景巡檢設定（預設開啟、每 300 秒巡檢一次）
PROACTIVE_ENABLED=true
PROACTIVE_POLL_SECONDS=300

# 選填：LINE Messaging API Bot 設定（詳見 LINE_SETUP.md）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 選填：你的公開 HTTPS 網頁網址（例如 https://xxx.hf.space），設定後 LINE 卡片會自動附上「開啟互動地圖與即時 CCTV」按鈕
PUBLIC_BASE_URL=
